{
  "name": "canyoncodecore",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.1"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck format:check",
    "format": "turbo run format",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:binary": "turbo run build:binary"
  },
  "devDependencies": {
    "turbo": "2.10.13"
  }
}
