# Copy to .env and fill in real values. Loaded by config/global_controller.yaml
# (env_file: .env) to resolve ${...} placeholders and to seed agent containers.

# --- AWS Bedrock (intent_agent, advisor_agent) ---
# Real AWS credentials, used to reach Bedrock through the CanyonOS LLM proxy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Alternative to the access-key pair above; set one or the other, not both.
AWS_BEARER_TOKEN_BEDROCK=
# Proxy base-url override -- points boto3's bedrock-runtime client at the
# local CanyonOS LLM proxy instead of the real AWS endpoint. See
# .claude/skills/porting-to-canyonos/references/llm-proxy.md.
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=http://host.docker.internal:8081/bedrock

# --- CanyonOS controller / web ---
CANYONOS_API_IMAGE=
CANYONOS_WEB_IMAGE=
CANYONOS_WEB_PORT=
CANYONOS_REDIS_HOST=
CANYONOS_REDIS_PORT=
CANYONOS_JWT_SECRET=
