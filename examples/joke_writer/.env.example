# Neither of these is a secret, and both have defaults in joke_writer.py --
# they are here to name what the source reads.
#
# Bedrock credentials are deliberately absent: boto3 resolves them from the
# instance role or the standard AWS chain. A key in this file would reach the
# image, since .env.example is the one exception to the build context's
# exclusion of .env*.

BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0
AWS_REGION=us-east-1
